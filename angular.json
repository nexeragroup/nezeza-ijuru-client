{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": "c002aa6c-3cd6-4795-b03b-1e403228cacd"
  },
  "newProjectRoot": "projects",
  "projects": {
    "client": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "standalone": false
        },
        "@schematics/angular:directive": {
          "standalone": false
        },
        "@schematics/angular:pipe": {
          "standalone": false
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "dev": {
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "ignore": ["robots.txt", "sitemap.xml"]
                },
                {
                  "glob": "robots.txt",
                  "input": "src/seo/dev",
                  "output": "/"
                }
              ],
              "outputPath": {
                "base": "dist/client/dev/ssr",
                "browser": "browser",
                "server": "server"
              },
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.dev.ts"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "security": {
                "allowedHosts": ["localhost", "127.0.0.1", "0.0.0.0"]
              }
            },
            "staging": {
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "ignore": ["robots.txt", "sitemap.xml"]
                },
                {
                  "glob": "robots.txt",
                  "input": "src/seo/staging",
                  "output": "/"
                }
              ],
              "outputPath": {
                "base": "dist/client/staging/ssr",
                "browser": "browser",
                "server": "server"
              },
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.staging.ts"
                }
              ],
              "optimization": true,
              "extractLicenses": true,
              "sourceMap": false,
              "outputHashing": "all",
              "security": {
                "allowedHosts": ["staging.nezezaijuru.org"]
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                }
              ]
            },
            "prod": {
              "outputPath": {
                "base": "dist/client/prod/ssr",
                "browser": "browser",
                "server": "server"
              },
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "extractLicenses": true,
              "sourceMap": false,
              "outputHashing": "all",
              "security": {
                "allowedHosts": ["nezezaijuru.org"]
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                }
              ]
            }
          },
          "defaultConfiguration": "prod"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "dev": {
              "buildTarget": "client:build:dev",
              "proxyConfig": "proxy/proxy.dev.mjs",
              "host": "0.0.0.0",
              "port": 4200,
              "allowedHosts": ["localhost", "127.0.0.1", "10.8.120.117"]
            },
            "staging": {
              "buildTarget": "client:build:staging",
              "proxyConfig": "proxy/proxy.staging.mjs",
              "allowedHosts": ["staging.nezezaijuru.org"]
            },
            "prod": {
              "buildTarget": "client:build:prod",
              "proxyConfig": "proxy/proxy.prod.mjs",
              "allowedHosts": ["nezezaijuru.org"]
            }
          },
          "defaultConfiguration": "dev"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
